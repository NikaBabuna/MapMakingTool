# File: .gitignore
# Purpose: Keeps build output, installed packages, local tools, editor files, and logs out of version control
# Audience: Agents and developers adding a tool or a build step
# Update when: A tool writes a new kind of file that is not to be committed

# Build
target/
**/target/

# Local bootstrap tools (not part of the repo)
.tools/

# Maven wrapper local
.mvn/wrapper/maven-wrapper.jar.download

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.project
.classpath
.settings/
.factorypath
out/
bin/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs / temp
*.log
*.tmp
*.swp
*~

# Next.js front (ui/web)
ui/web/node_modules/
ui/web/.next/
ui/web/out/
ui/web/.env*.local
ui/web/tsconfig.tsbuildinfo

# Tauri desktop (ui/desktop)
ui/desktop/node_modules/
ui/desktop/src-tauri/target/
ui/desktop/src-tauri/gen/
